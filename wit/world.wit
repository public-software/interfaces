// public:core, the contract every Public Software platform component binds.
// Versioned as RFC-0002 says: every item names the release that added it.
package public:core@0.1.0;

/// What a host provides to every component of the platform.
@since(version = 0.1.0)
world imports {
    @since(version = 0.1.0)
    import logging;
    @since(version = 0.1.0)
    import config;
    @since(version = 0.1.0)
    import clock;
    /// Arguments, environment variables and the initial working directory, from WASI.
    @since(version = 0.1.0)
    import wasi:cli/environment@0.3.0;
}

/// A platform component: it sees the host's imports and answers health checks.
@since(version = 0.1.0)
world component {
    @since(version = 0.1.0)
    include imports;
    @since(version = 0.1.0)
    export health;
}
